{
  "name": "granka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.mjs && node test/markdown.mjs && node test/tools.mjs && node test/docs.mjs && node test/themes.mjs && node test/css-tokens.mjs",
    "test:ui": "electron test/ui.mjs",
    "test:settings": "electron test/settings-ui.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:settings && npm run test:theme",
    "test:theme": "electron test/theme-broadcast.mjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "electron": "^45.2.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  },
  "description": "granka — desktop client for the Pi coding agent",
  "build": {
    "appId": "dev.granka.app",
    "productName": "granka",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "NOTICE.md",
      "README.md"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**",
      "node_modules/unpdf/**",
      "node_modules/@cantoo/**",
      "node_modules/@pdf-lib/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development",
      "maintainer": "granka",
      "icon": "build/icons",
      "executableName": "granka"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "granka-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "icon": "build/icon.png",
    "asar": true
  }
}
